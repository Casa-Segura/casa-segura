# Casa Segura — backend environment template.
#
# Copy to `backend/.env` and fill in the secrets. The real `.env` is
# gitignored. NEVER commit `.env` itself. Keys/services listed here are
# consumed by `backend/config/settings.py` via django-environ.
#
# Local dev: bring up Postgres+Redis with `docker compose -f
# docker-compose.dev.yml up -d` from the repo root, then defaults below
# work as-is.

# ─── Django core ───
SECRET_KEY=<generate-50-char-random>
DEBUG=True
LOG_LEVEL=INFO
ALLOWED_HOSTS=*

# ─── Database (Postgres 15 + pgvector) ───
DB_ENGINE=postgresql
DB_NAME=casasegura
DB_USER=postgres
DB_PASSWORD=<your-db-password>
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# ─── Celery / Redis ───
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── OpenRouter (LLM gateway) ───
OPENROUTER_API_KEY=<sk-or-v1-...>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Phase 1 OCR: single multimodal model (handles photos via image_url AND PDFs
# via file + file-parser plugin). See `ingestion/application/ocr/extractors/pixtral.py`.
OPENROUTER_OCR_MODEL=mistralai/pixtral-large-2411
OPENROUTER_PDF_PLUGIN_ENGINE=mistral-ocr
OPENROUTER_DEFAULT_TEXT_MODEL=mistralai/pixtral-large-2411
# Tracking headers required by OpenRouter (no secrets — used in dashboard attribution).
OPENROUTER_HTTP_REFERER=https://casa-segura.local
OPENROUTER_X_TITLE=Casa Segura OCR
# Timeouts and retries for the gateway client.
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3

# ─── OCR pipeline (Phase 1, EPIC-02) ───
OCR_MAX_PAGES=50
OCR_MAX_BYTES=10485760
OCR_VISION_LLM_TIMEOUT=60
OCR_TESSERACT_ENABLED=true
OCR_TESSERACT_LANG=spa
OCR_TESSERACT_MIN_CONFIDENCE=60

# ─── RAG retrieval (Phase 1, EPIC-03) ───
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=5
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ─── Zavu integration ───
ZAVU_API_KEY=<zavu-api-key>
ZAVU_WEBHOOK_SECRET=<zavu-webhook-shared-secret>
ZAVU_BASE_URL=<https://api.zavu.example>

# ─── KMS / crypto ───
KMS_PROVIDER=local
KMS_KEY_ID=<kms-key-id-or-empty-for-local>
INTERNAL_AUTH_SECRET=<generate-50-char-random>

# ─── Active catalog versions ───
ACTIVE_RUBRIC_VERSION=
# FIXME(CS-XXX): variable name has a typo (`CORPUSF` → `CORPUS`). Kept as-is
# so this template matches the live `backend/.env` until a rename ticket
# lands; renaming requires coordinated update of settings.py + .env on every
# environment.
ACTIVE_CORPUSF_VERSION=
ACTIVE_BENCHMARK_VERSION=
