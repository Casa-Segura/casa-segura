# Casa Segura — backend environment template.
#
# Copy to `backend/.env` and fill in the secrets. The real `.env` is
# gitignored. NEVER commit `.env` itself. Keys/services listed here are
# consumed by `backend/config/settings.py` via django-environ.
#
# Local dev: bring up Postgres+Redis with `docker compose -f
# docker-compose.dev.yml up -d` from the repo root, then defaults below
# work as-is.

# ─── Django core ───
SECRET_KEY=<generate-50-char-random>
DEBUG=True
LOG_LEVEL=INFO
ALLOWED_HOSTS=*

# ─── Database (Postgres 15 + pgvector) ───
DB_ENGINE=postgresql
DB_NAME=casasegura
DB_USER=postgres
# Same as `docker-compose.dev.yml` / CI Postgres. Override for a non-Docker DB.
DB_PASSWORD=administrador
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# Per-request `transaction.atomic()` wrapper (CS-022 AC2). Default False — wrap
# only the views that need cross-table consistency. Setting True wraps every
# request in an implicit transaction (slower; rolls back on any uncaught error).
DB_ATOMIC_REQUESTS=False
# Connection pool bounds — applied by PgBouncer / Railway proxy in front of
# Postgres (PRD F8 §6.3). Django itself uses CONN_MAX_AGE above for per-worker
# reuse; these are advisory for the platform pool.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20

# ─── Celery / Redis ───
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ─── OpenRouter (LLM gateway) ───
OPENROUTER_API_KEY=<sk-or-v1-...>
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Phase 1 OCR: single multimodal model (handles photos via image_url AND PDFs
# via file + file-parser plugin). See `ingestion/application/ocr/extractors/pixtral.py`.
OPENROUTER_OCR_MODEL=mistralai/pixtral-large-2411
OPENROUTER_PDF_PLUGIN_ENGINE=mistral-ocr
OPENROUTER_DEFAULT_TEXT_MODEL=mistralai/pixtral-large-2411
# Tracking headers required by OpenRouter (no secrets — used in dashboard attribution).
OPENROUTER_HTTP_REFERER=https://casa-segura.local
OPENROUTER_X_TITLE=Casa Segura OCR
# Timeouts and retries for the gateway client.
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=3

# ─── OCR pipeline (Phase 1, EPIC-02) ───
OCR_MAX_PAGES=50
OCR_MAX_BYTES=10485760
OCR_VISION_LLM_TIMEOUT=60
OCR_TESSERACT_ENABLED=true
OCR_TESSERACT_LANG=spa
OCR_TESSERACT_MIN_CONFIDENCE=60
# PRD BE-SERVICES §3.5 canonical names (mirrors of the OCR_* keys above to
# match the PRD env-surface contract — settings.py honours either name).
# `PDF_MAX_PAGES`: ingestion rejects files past this bound with
# `not_analyzable` / ingestion error per PRD ingestion alignment.
PDF_MAX_PAGES=50
# `OCR_FALLBACK_ENABLED`: gate the Tesseract fallback path (mirror of
# OCR_TESSERACT_ENABLED). Default true so degraded LLM responses still recover.
OCR_FALLBACK_ENABLED=true
# `TESSERACT_LANG`: mirror of OCR_TESSERACT_LANG. ISO-639-2 code (`spa` for ES).
TESSERACT_LANG=spa

# ─── RAG retrieval (Phase 1, EPIC-03) ───
# Cite-or-stay-silent: a chunk below this cosine similarity is dropped from
# context (`STATUS_RECONCILIATION` BVA — 0.649 drops, 0.651 retains).
RAG_SIMILARITY_THRESHOLD=0.65
RAG_TOP_K=5
# Cross-encoder reranker: bi-encoder vector search clusters legal-prose
# scores tight (~0.03 deltas). Reranker pulls top-N=RAG_RERANKER_POOL_SIZE
# from pgvector then reorders by relevance.
RAG_RERANKER_ENABLED=true
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_POOL_SIZE=10
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Embedding dimensionality — must match the `vector(N)` column in
# `corpus.LegalChunk` and the active sentence-transformers model.
EMBEDDING_DIM=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ─── SMS delivery integration ───
SMS_PROVIDER=local
SMS_API_KEY=<sms-api-key>
SMS_WEBHOOK_SECRET=<sms-webhook-shared-secret>
SMS_API_BASE_URL=<https://api.sms-provider.example>
SMS_FROM=<registered-sender-or-phone>

# ─── KMS / crypto ───
KMS_PROVIDER=local
KMS_KEY_ID=<kms-key-id-or-empty-for-local>
INTERNAL_AUTH_SECRET=<generate-50-char-random>

# ─── Jobs / retention (PRD F8 §6.3) ───
# Days to keep PII attached to a Project before anonymization. Default 90 per
# PRD BR-03; downward-only adjustment allowed without review; lengthening
# requires a privacy review.
ANONYMIZATION_AFTER_DAYS=90
# Batch size for retention/anonymization Celery jobs (single transactional
# chunk; keep small to bound lock duration).
JOB_BATCH_SIZE=100
# IANA timezone for Celery beat schedules (PRD F8 §6.3). El Salvador is
# `America/El_Salvador`; UTC chosen here so cron expressions are unambiguous.
JOB_TIMEZONE=UTC

# ─── Report link TTL (proposed, EPIC-07) ───
# Days a delivered report's public-short-id link stays live before it 404s.
# PRD_GENERAL open question — default proposed at 30 days. Final value lands
# with the EPIC-07 closeout ticket; documented here so no magic number ships
# without an env knob to flip.
REPORT_LINK_TTL_DAYS=30

# ─── Active catalog versions ───
ACTIVE_RUBRIC_VERSION=
# FIXME(CS-XXX): variable name has a typo (`CORPUSF` → `CORPUS`). Kept as-is
# so this template matches the live `backend/.env` until a rename ticket
# lands; renaming requires coordinated update of settings.py + .env on every
# environment.
ACTIVE_CORPUSF_VERSION=
ACTIVE_BENCHMARK_VERSION=

# ─── Railway (PaaS, NOT for local `.env`) ───
# Documents the Railway-only env surface for the `web` / `worker` / `beat`
# services. See RAILWAY.md at the repo root for service-by-service setup.
#
# DATABASE_URL — Railway exposes this from the Postgres plugin via reference
# variable `${{Postgres.DATABASE_URL}}`. When present, OVERRIDES the discrete
# DB_* vars above. Format: postgres://user:pass@host:port/dbname
# DATABASE_URL=
#
# RAILWAY_PUBLIC_DOMAIN — auto-injected by Railway as the *.up.railway.app
# hostname. `config/settings.py` appends it to ALLOWED_HOSTS +
# CSRF_TRUSTED_ORIGINS automatically. Do not set manually.
# RAILWAY_PUBLIC_DOMAIN=
#
# CSRF_TRUSTED_ORIGINS — comma-separated full origins (https://example.com)
# for any custom domain you front the API with.
# CSRF_TRUSTED_ORIGINS=

# comentario