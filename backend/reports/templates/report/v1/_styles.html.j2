<style>
:root {
    --color-text: #111827;
    --color-muted: #4B5563;
    --color-bg: #FFFFFF;
    --color-surface: #F9FAFB;
    --color-border: #E5E7EB;
    --color-warning-bg: #FEF3C7;
    --color-warning-border: #FBBF24;
    --color-critical-bg: #FEE2E2;
    --color-critical-border: #EF4444;
    --color-success: #10B981;
    --color-yellow: #F59E0B;
    --color-red: #EF4444;
    --max-width: 920px;
    --pad-base: 16px;
    --pad-lg: 24px;
    --radius: 8px;
    --font-base: 16px;
}
* { box-sizing: border-box; }
body {
    color: var(--color-text);
    background: var(--color-bg);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: var(--font-base);
    line-height: 1.55;
    margin: 0;
    padding: 0;
}
section, header, footer { max-width: var(--max-width); margin: 0 auto; padding: var(--pad-lg) var(--pad-base); }
.cs-section-title { font-size: 1.5rem; margin: 0 0 0.5rem; color: var(--color-text); }
.cs-muted { color: var(--color-muted); }
.cs-disclaimer { background: var(--color-warning-bg); border: 1px solid var(--color-warning-border); border-radius: var(--radius); padding: 12px 16px; font-weight: 600; }
.cs-header { border-bottom: 1px solid var(--color-border); }
.cs-header .cs-wordmark { font-weight: 700; font-size: 1.25rem; letter-spacing: 0.02em; }
.cs-header .cs-meta { display: grid; gap: 4px; margin-top: 8px; color: var(--color-muted); }
.cs-header .cs-reclass { margin-top: 8px; }
.cs-verdict .cs-score-block { display: flex; align-items: baseline; gap: 16px; }
.cs-verdict .cs-score { font-size: 4rem; font-weight: 800; color: var(--band, #111827); line-height: 1; }
.cs-verdict .cs-band { font-size: 1.25rem; font-weight: 700; color: var(--band, #111827); }
.cs-override-box { background: var(--color-critical-bg); border: 2px solid var(--color-critical-border); border-radius: var(--radius); padding: 16px; margin-top: 16px; }
.cs-override-box h3 { margin: 0 0 8px; color: var(--color-critical-border); }
.cs-override-box ul { margin: 8px 0; padding-left: 20px; }
.cs-economic table { width: 100%; border-collapse: collapse; margin-top: 12px; }
.cs-economic th, .cs-economic td { border-bottom: 1px solid var(--color-border); padding: 8px; text-align: left; vertical-align: top; }
.cs-economic .cs-assessment-well_above_market { color: var(--color-red); font-weight: 600; }
.cs-economic .cs-assessment-above_market { color: var(--color-yellow); font-weight: 600; }
.cs-economic .cs-assessment-below_market_favorable { color: var(--color-success); font-weight: 600; }
.cs-economic .cs-art-1686 { background: var(--color-warning-bg); border-left: 4px solid var(--color-warning-border); padding: 12px 16px; border-radius: var(--radius); margin-top: 16px; }
.cs-economic svg { display: block; max-width: 100%; height: auto; }
.cs-categories details { border: 1px solid var(--color-border); border-radius: var(--radius); margin-bottom: 12px; }
.cs-categories summary { padding: 12px 16px; cursor: pointer; font-weight: 600; }
.cs-categories .cs-category-bar { background: var(--color-surface); height: 8px; border-radius: 4px; overflow: hidden; margin: 6px 0; }
.cs-categories .cs-category-bar > span { display: block; height: 100%; background: var(--color-success); }
.cs-categories ul { margin: 0; padding: 12px 16px; list-style: none; display: grid; gap: 8px; }
.cs-categories ul li { display: grid; grid-template-columns: auto 1fr auto; gap: 8px; align-items: baseline; }
.cs-findings .cs-finding-card { border: 1px solid var(--color-border); border-radius: var(--radius); padding: 16px; margin-bottom: 12px; }
.cs-findings .cs-finding-card.cs-severity-critical { border-color: var(--color-critical-border); background: var(--color-critical-bg); }
.cs-findings .cs-evidence { background: var(--color-surface); border-left: 4px solid var(--color-border); padding: 8px 12px; font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace; font-size: 0.95em; margin: 8px 0; white-space: pre-wrap; }
.cs-findings .cs-legal-card { border: 1px dashed var(--color-border); border-radius: var(--radius); padding: 8px 12px; margin: 8px 0; }
.cs-findings .cs-recommendation { background: #ECFDF5; border-left: 4px solid var(--color-success); padding: 8px 12px; margin-top: 8px; border-radius: var(--radius); }
.cs-legal-refs ul { padding-left: 20px; }
.cs-actions .cs-actions-grid { display: grid; gap: 16px; }
.cs-actions h3 { margin: 0 0 8px; }
.cs-footer { border-top: 1px solid var(--color-border); color: var(--color-muted); font-size: 0.9em; }
.cs-footer code { background: var(--color-surface); padding: 2px 6px; border-radius: 4px; }
@media (min-width: 600px) {
    .cs-categories ul { grid-template-columns: 1fr 1fr; }
    .cs-actions .cs-actions-grid { grid-template-columns: 1fr 1fr 1fr; }
}
@media (forced-colors: active) {
    .cs-verdict .cs-score, .cs-verdict .cs-band { color: CanvasText; }
    .cs-override-box { border-color: CanvasText; }
}
</style>
