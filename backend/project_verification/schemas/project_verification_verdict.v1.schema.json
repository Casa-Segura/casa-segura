{"$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://casasegura.local/schemas/project-verification-verdict-v1.schema.json", "title": "ProjectVerificationVerdictV1", "type": "object", "additionalProperties": true, "required": ["verdict", "headline_key", "heuristic_score", "rationale_keys"], "properties": {"verdict": {"type": "string", "enum": ["green", "yellow", "red"], "description": "Consumer-facing heuristic band mapped from internal 0-10 thresholds (US-03)."}, "headline_key": {"type": "string", "minLength": 1}, "heuristic_score": {"type": "number", "minimum": 0, "maximum": 10}, "rationale_keys": {"type": "array", "items": {"type": "string", "minLength": 1}}, "reference_id": {"type": "string", "description": "Optional correlation handle for telemetry only (no linkage to contracts)."}}}
