# Server-only Casa Segura API (CS-296) — Never put secrets in NEXT_PUBLIC_*.
CASASEGURA_API_BASE_URL=http://127.0.0.1:8000

# Optional paths — defaults match Django ingestion (`backend/ingestion/interfaces/api/urls.py`).
# CASASEGURA_CONTRACT_SUBMIT_PATH=/api/v1/submissions/
# CASASEGURA_CONTRACT_SUBMISSION_PATH_TEMPLATE=/api/v1/submissions/{{id}}/

# Timeouts — submit ~90s; poll budget defaults allow ~120s backoff loop (1s→2s→5s cap).
# CASASEGURA_UPLOAD_SUBMIT_TIMEOUT_MS=90000
# CASASEGURA_UPLOAD_POLL_BUDGET_MS=120000
# CASASEGURA_UPLOAD_POLL_BACKOFF_MS=1000,2000,5000

# Public HTML report path (F7-style). `{{id}}` = public_short_id (CS-294).
# CASASEGURA_PUBLIC_REPORT_PATH_TEMPLATE=/r/{{id}}

# Temporary kill-switch for public envs pending BE readiness:
# CASASEGURA_UPLOAD_ENABLED=false
